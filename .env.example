# Database Configuration
DB_HOST=localhost           # Database host, e.g., localhost or mydatabase.com
DB_PORT=5432                # Database port, e.g., 5432 for PostgreSQL
DB_USER=your_user           # Database username
DB_PASSWORD=your_password   # Database password
DB_NAME=your_database       # Name of the database

# Server Configuration
SERVER_PORT=3000            # Port for the application server
NODE_ENV=development         # Environment type (development, production)

# API Keys
API_KEY=your_api_key        # API key for external service

# Other Configurations
SECRET_KEY=your_secret_key  # Secret key for session management
