{
  "installCommand": "corepack enable pnpm && pnpm install",
  "buildCommand": "pnpm run build",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/cron/cleanup",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/expiry-alerts",
      "schedule": "0 * * * *"
    }
  ],
  "functions": {
    "src/app/api/push/send/route.ts": {
      "memory": 1024
    },
    "src/app/api/push/subscribe/route.ts": {
      "memory": 512
    },
    "src/app/api/push/unsubscribe/route.ts": {
      "memory": 512
    },
    "src/app/api/messages/send/route.ts": {
      "memory": 512
    },
    "src/app/api/messages/mark-read/route.ts": {
      "memory": 512
    },
    "src/app/api/file/[bucket]/[fileId]/route.ts": {
      "memory": 512
    },
    "src/app/api/link-preview/route.ts": {
      "memory": 512
    },
    "src/app/api/admin/products/delete/route.ts": {
      "memory": 512
    },
    "src/app/api/admin/users/warn/route.ts": {
      "memory": 512
    }
  }
}
