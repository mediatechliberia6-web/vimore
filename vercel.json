{
  "installCommand": "corepack enable pnpm && pnpm install --frozen-lockfile",
  "buildCommand": "pnpm run build",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/cron/cleanup",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/expiry-alerts",
      "schedule": "0 * * * *"
    }
  ],
  "functions": {
    "src/app/api/cron/cleanup/route.ts": {
      "memory": 1024,
      "maxDuration": 60
    },
    "src/app/api/cron/expiry-alerts/route.ts": {
      "memory": 1024,
      "maxDuration": 60
    },
    "src/app/api/moderate/route.ts": {
